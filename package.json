{
  "name": "kino",
  "version": "0.1.0-rc.6",
  "private": true,
  "type": "module",
  "description": "A Stremio-compatible media client with an original interface.",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "checkSteps": [
    "format:check",
    "version:check",
    "gates:check-wiring",
    "prose:check",
    "contracts:check",
    "gates:check-sleeps",
    "lint",
    "typecheck",
    "test",
    "core:check-contract",
    "core:check-seasons",
    "core:check-watched",
    "core:check-streams",
    "core:check-pagination",
    "core:check-subtitles",
    "core:check-shutdown",
    "intro:check",
    "core:check-addon-transports",
    "engine:check-vendor",
    "notices:check",
    "macos:check-icon",
    "windows:check-icon",
    "android:check-banner",
    "android:check-settings",
    "settings:check-consumers",
    "build"
  ],
  "macosProbeSteps": [
    "macos:check-launch",
    "macos:check-engine",
    "macos:check-cache-clear",
    "macos:check-scale",
    "macos:check-focus",
    "macos:check-resume",
    "macos:check-intro",
    "macos:check-seasons",
    "macos:check-fullscreen",
    "macos:check-volume",
    "macos:check-audio",
    "macos:check-track-choices",
    "macos:check-web-console",
    "macos:check-navigation",
    "macos:check-interface-recovery",
    "macos:check-tls",
    "macos:check-engine-ui",
    "macos:check-engine-retry",
    "macos:check-request-headers",
    "macos:check-shutdown",
    "macos:check-addon-transports"
  ],
  "linuxProbeSteps": [
    "macos:check-launch",
    "macos:check-navigation",
    "macos:check-focus",
    "macos:check-scale",
    "macos:check-interface-recovery"
  ],
  "scripts": {
    "build": "pnpm --filter @kino/desktop build",
    "check": "node scripts/run-check.mjs",
    "macos:check-probes": "node scripts/run-check.mjs macosProbeSteps",
    "linux:check-probes": "node scripts/run-check.mjs linuxProbeSteps",
    "core:capture-fixtures": "node scripts/capture-core-fixtures.mjs",
    "core:check-seasons": "node scripts/check-core-seasons.mjs",
    "core:check-watched": "node scripts/check-core-watched.mjs",
    "core:check-contract": "node scripts/check-core-contract.mjs",
    "core:check-streams": "node scripts/check-core-streams.mjs",
    "core:check-subtitles": "node scripts/check-core-subtitles.mjs",
    "core:check-shutdown": "node scripts/check-core-shutdown.mjs",
    "core:check-addon-transports": "node scripts/check-core-addon-transports.mjs",
    "dev": "pnpm --filter @kino/desktop dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "engine:build": "./scripts/build-engine.sh",
    "engine:check-vendor": "node scripts/check-engine-vendor.mjs",
    "engine:check-profile": "node scripts/check-engine-profile.mjs",
    "engine:check-trackers": "node scripts/check-engine-trackers.mjs",
    "macos:build": "./scripts/build-macos.sh",
    "macos:check-engine": "./scripts/check-macos-engine.sh",
    "macos:check-engine-ui": "node scripts/check-macos-engine-ui.mjs",
    "macos:check-cache-clear": "node scripts/check-macos-cache-clear.mjs",
    "macos:check-engine-retry": "node scripts/check-macos-engine-retry.mjs",
    "macos:check-scale": "node scripts/check-macos-scale.mjs",
    "macos:check-focus": "node scripts/check-macos-focus.mjs",
    "macos:check-seasons": "node scripts/check-macos-seasons.mjs",
    "macos:check-resume": "node scripts/check-macos-resume.mjs",
    "macos:check-fullscreen": "node scripts/check-macos-fullscreen.mjs",
    "macos:check-navigation": "node scripts/check-macos-navigation.mjs",
    "macos:check-track-choices": "node scripts/check-macos-track-choices.mjs",
    "macos:check-audio": "node scripts/check-macos-audio.mjs",
    "macos:check-volume": "node scripts/check-macos-volume.mjs",
    "macos:check-web-console": "node scripts/check-macos-web-console.mjs",
    "macos:check-launch": "./scripts/check-macos-launch.sh",
    "macos:check-playback": "node scripts/check-macos-playback.mjs",
    "linux:check-sleep": "node scripts/check-linux-sleep.mjs",
    "macos:check-request-headers": "node scripts/check-macos-request-headers.mjs",
    "macos:check-tls": "node scripts/check-macos-tls.mjs",
    "macos:check-shutdown": "node scripts/check-macos-shutdown.mjs",
    "macos:check-interface-recovery": "node scripts/check-macos-interface-recovery.mjs",
    "macos:check-addon-transports": "node scripts/check-macos-addon-transports.mjs",
    "macos:icon": "swift scripts/build-macos-icon.swift",
    "macos:check-icon": "node scripts/check-macos-icon.mjs",
    "windows:icon": "swift scripts/build-windows-icon.swift",
    "windows:check-icon": "node scripts/check-windows-icon.mjs",
    "macos:package": "node scripts/package-macos.mjs",
    "macos:check-package": "node scripts/check-macos-package.mjs",
    "test": "pnpm --filter @kino/desktop test",
    "typecheck": "pnpm --filter @kino/desktop typecheck",
    "version:check": "node scripts/check-version.mjs",
    "gates:check-wiring": "node scripts/check-gate-wiring.mjs",
    "prose:check": "node scripts/check-prose.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "gates:check-sleeps": "node scripts/check-fixed-sleeps.mjs",
    "core:check-pagination": "node scripts/check-core-pagination.mjs",
    "notices:check": "node scripts/check-license-notices.mjs",
    "notices:refresh": "node scripts/refresh-notices.mjs",
    "android:build": "python3 scripts/build-android.py",
    "android:run": "python3 scripts/run-android.py",
    "android:banner": "swift scripts/build-tv-banner.swift",
    "android:check": "python3 scripts/check-android.py",
    "android:check-banner": "node scripts/check-tv-banner.mjs",
    "android:settings": "node scripts/generate-tv-settings.mjs",
    "android:check-settings": "node scripts/generate-tv-settings.mjs --check",
    "settings:check-consumers": "node scripts/check-setting-consumers.mjs",
    "android:check-signature": "node scripts/check-android-signature.mjs",
    "intro:check": "node scripts/check-intro-community.mjs",
    "intro:check-live": "node scripts/check-intro-live.mjs",
    "macos:check-intro": "node scripts/check-intro-community.mjs --macos"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
