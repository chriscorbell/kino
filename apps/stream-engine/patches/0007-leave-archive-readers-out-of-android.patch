+
+#[cfg(not(target_os = "android"))]
+fn rar_reader(path: &Path, cache_config: CacheConfig) -> Result<Box<dyn ArchiveReader>> {
+    Ok(Box::new(rar::RarHandler::new_with_config(
+        path.to_path_buf(),
+        cache_config,
+    )))
+}
+
+#[cfg(not(target_os = "android"))]
+fn sevenz_reader(path: &Path, cache_config: CacheConfig) -> Result<Box<dyn ArchiveReader>> {
+    Ok(Box::new(sevenz::SevenZHandler::new_with_config(
+        path.to_path_buf(),
+        cache_config,
+    )))
+}
+
+#[cfg(not(target_os = "android"))]
+fn sevenz_stream_reader(reader: Box<dyn AsyncSeekableReader>) -> Result<Box<dyn ArchiveReader>> {
+    Ok(Box::new(sevenz::SevenZHandler::new_with_reader(reader)))
+}
+
+// RAR and 7z are C++ bound with autocxx, which cannot parse Android's sysroot from a Linux host.
+// Kino never serves archives, so its Android engine is built without them.
+#[cfg(target_os = "android")]
+fn rar_reader(_path: &Path, _cache_config: CacheConfig) -> Result<Box<dyn ArchiveReader>> {
+    Err(anyhow::anyhow!("RAR archives are not available in this build"))
+}
+
+#[cfg(target_os = "android")]
+fn sevenz_reader(_path: &Path, _cache_config: CacheConfig) -> Result<Box<dyn ArchiveReader>> {
+    Err(anyhow::anyhow!("7z archives are not available in this build"))
+}
+
+#[cfg(target_os = "android")]
+fn sevenz_stream_reader(_reader: Box<dyn AsyncSeekableReader>) -> Result<Box<dyn ArchiveReader>> {
+    Err(anyhow::anyhow!("7z archives are not available in this build"))
+}
