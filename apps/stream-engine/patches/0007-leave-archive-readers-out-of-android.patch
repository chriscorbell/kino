 sysinfo = "0.39.5"
 
@@ -131,3 +129,9 @@ eula = false
 [build-dependencies]
 winres = "0.1"
 chrono = "0.4.42"
+
+# RAR and 7z come from C++ sources bound with autocxx, whose bindgen step cannot parse Android's
+# sysroot on a Linux host. Kino never serves archives, so its Android engine leaves them out.
+[target.'cfg(not(target_os = "android"))'.dependencies]
+async-rar = { path = "../bindings/async-rar" }
+async-sevenz = { path = "../bindings/async-sevenz" }
