diff --git a/enginefs/src/http_client.rs b/enginefs/src/http_client.rs
new file mode 100644
index 0000000..dd442ae
--- /dev/null
+++ b/enginefs/src/http_client.rs
@@ -0,0 +1,20 @@
+//! HTTP clients for the engine's own requests: the tracker list and tracker probes.
+//!
+//! reqwest verifies certificates through rustls-platform-verifier, which on Android calls the
+//! platform's trust manager through a JVM. Kino runs the engine as its own process there, with no
+//! JVM, so it passes the system's roots in the file named by SSL_CERT_FILE instead, the same file
+//! libtorrent's OpenSSL reads.
+
+pub fn builder() -> reqwest::ClientBuilder {
+    let builder = reqwest::Client::builder();
+    #[cfg(target_os = "android")]
+    let builder = match std::env::var_os("SSL_CERT_FILE")
+        .and_then(|path| std::fs::read(path).ok())
+        .and_then(|pem| reqwest::Certificate::from_pem_bundle(&pem).ok())
+    {
+        Some(roots) if !roots.is_empty() => builder.tls_certs_only(roots),
+        // Without roots every HTTPS request fails closed rather than trusting anything.
+        _ => builder.tls_certs_only(Vec::new()),
+    };
+    builder
+}
