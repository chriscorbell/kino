// Kino.exe's icon and version, which Explorer, the taskbar and Task Manager
// read. Qt gives every window the icon named IDI_ICON1. Windows names an
// unpackaged app by its FileDescription, in the media overlay among others.
#include <winver.h>

IDI_ICON1 ICON "@KINO_WINDOWS_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Kino"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "Kino"
      VALUE "OriginalFilename", "Kino.exe"
      VALUE "ProductName", "Kino"
      VALUE "ProductVersion", "@KINO_RELEASE_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
