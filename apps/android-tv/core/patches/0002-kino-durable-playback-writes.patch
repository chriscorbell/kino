+#[derive(Default)]
+struct State {
+    generation: u64,
+    latest: HashMap<String, u64>,
+    failed: HashMap<String, Option<StoredValue>>,
+    writes: usize,
+    puts: usize,
+}
+
+struct Write {
+    value: StoredValue,
+    generation: u64,
+    complete: oneshot::Sender<Result<(), EnvError>>,
+}
+
+static STATE: Lazy<(Mutex<State>, Condvar)> =
+    Lazy::new(|| (Mutex::new(State::default()), Condvar::new()));
+static WRITER: Lazy<mpsc::Sender<Write>> = Lazy::new(|| {
+    let (sender, receiver) = mpsc::channel::<Write>();
+    std::thread::Builder::new()
+        .name("KinoStorage".into())
+        .spawn(move || {
+            for write in receiver {
+                let result = write.value.persist();
+                {
+                    let mut state = STATE.0.lock().expect("Persistence lock failed");
+                    state.writes -= 1;
+                    if state.latest.get(&write.value.key) == Some(&write.generation) {
+                        if result.is_ok() {
+                            state.failed.remove(&write.value.key);
+                        } else {
+                            state
+                                .failed
+                                .insert(write.value.key.clone(), Some(write.value));
+                        }
+                    }
+                    STATE.1.notify_all();
+                }
+                let _ = write.complete.send(result);
+            }
+        })
+        .expect("Storage worker initialization failed");
+    sender
+});
+
+fn enqueue(state: &mut State, value: StoredValue) -> oneshot::Receiver<Result<(), EnvError>> {
+    state.generation += 1;
+    let generation = state.generation;
+    state.latest.insert(value.key.clone(), generation);
+    state.failed.remove(&value.key);
+    state.writes += 1;
+    let (complete, receiver) = oneshot::channel();
+    // Registration and enqueue share the lock: an older snapshot cannot be
+    // committed after a newer one just because Tokio polls futures out of order.
+    WRITER
+        .send(Write {
+            value,
+            generation,
+            complete,
+        })
+        .expect("Storage worker stopped");
+    receiver
+}
+
+pub(super) fn write(value: StoredValue) -> oneshot::Receiver<Result<(), EnvError>> {
+    enqueue(&mut STATE.0.lock().expect("Persistence lock failed"), value)
+}
+
+pub(super) fn serialization_failed(key: &str) {
+    let mut state = STATE.0.lock().expect("Persistence lock failed");
+    state.generation += 1;
+    let generation = state.generation;
+    state.latest.insert(key.to_owned(), generation);
+    state.failed.insert(key.to_owned(), None);
+    STATE.1.notify_all();
+}
+
+/// Registered before the API future is returned; dropped only after its body
+/// has been read, on failure, or on cancellation. A catalog GET never owns one.
+pub(super) struct LibraryPut;
+impl LibraryPut {
+    pub(super) fn new() -> Self {
+        STATE.0.lock().expect("Persistence lock failed").puts += 1;
+        Self
+    }
+}
+impl Drop for LibraryPut {
+    fn drop(&mut self) {
+        let mut state = STATE.0.lock().expect("Persistence lock failed");
+        state.puts -= 1;
+        STATE.1.notify_all();
+    }
+}
+
+/// True acknowledges durable local writes and completion of library puts. A
+/// failed account request does not discard progress already stored locally.
+pub fn drain(retry: bool) -> bool {
+    let deadline = Instant::now() + Duration::from_secs(25);
+    let mut state = STATE.0.lock().expect("Persistence lock failed");
+    if retry {
+        // Core already holds the updated item and may deduplicate the same
+        // PausedChanged action. Retry the serialized value that failed instead.
+        let failed: Vec<_> = state.failed.values().filter_map(Clone::clone).collect();
+        for value in failed {
+            let _ = enqueue(&mut state, value);
+        }
+    }
+    while state.writes != 0 || state.puts != 0 {
+        let Some(remaining) = deadline.checked_duration_since(Instant::now()) else {
+            return false;
+        };
+        state = STATE
+            .1
+            .wait_timeout(state, remaining)
+            .expect("Persistence wait failed")
+            .0;
+    }
+    state.failed.is_empty()
+}
