      "expect": null
    },
    {
      "name": "the episode being played",
      "type": "series",
      "playingId": "tt0903747:1:1",
      "next": { "id": "tt0903747:1:1", "upcoming": false },
      "expect": null
    },
    {
      "name": "a movie with another video after it",
      "type": "movie",
      "playingId": "tt0133093",
      "next": { "id": "tt0133093:extra", "upcoming": false },
      "expect": null
    },
    {
      "name": "the last episode, where Core offers nothing",
      "type": "series",
      "playingId": "tt0903747:5:16",
      "next": null,
      "expect": null
    }
  ]
